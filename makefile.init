# Generate before dependency scanning, including parallel/incremental builds.
ifneq ($(strip $(MAKECMDGOALS)),clean)
VERSION_ROOT := $(dir $(abspath $(lastword $(MAKEFILE_LIST))))
VERSION_GENERATED := $(shell sh "$(VERSION_ROOT)scripts/gen_version.sh" && echo ok)
ifneq ($(VERSION_GENERATED),ok)
$(error Failed to generate firmware Git version)
endif
endif
